{
  "name": "qqshow2000",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win dir"
  },
  "build": {
    "appId": "com.qqshow.desktop",
    "productName": "QQShow2000",
    "directories": { "output": "dist" },
    "files": ["main.js", "index.html", "assets/**/*"],
    "win": { "icon": "assets/icons/qqshow_icon.PNG", "target": "dir" }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0"
  }
}
